version: "2"

run:
  timeout: 5m

linters:
  default: none
  enable:
    - errcheck
    - govet
    - staticcheck
    - unused
    - misspell
    - revive
  settings:
    revive:
      rules:
        - name: exported
        - name: package-comments
        - name: error-strings
        - name: unused-parameter
  exclusions:
    generated: lax
    paths:
      - ".*_templ\\.go$"

formatters:
  enable:
    - gofumpt
    - goimports
  settings:
    gofumpt:
      # Keep equal to the module line in go.mod: gofumpt groups imports by it,
      # and a module path without a dot is otherwise taken for the stdlib.
      module-path: "{{ .Module }}"
