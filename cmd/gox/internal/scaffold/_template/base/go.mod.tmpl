module {{ .Module }}

go {{ .GoVersion }}
{{- if .Web }}

// The templ library stays on the version `make generate` runs (TEMPL_VERSION).
require github.com/a-h/templ {{ .TemplVersion }}
{{- end }}
{{- if .GoxDir }}

// Development: the gox modules come from a local checkout. Remove these
// lines to use released versions.
replace github.com/guilhermebr/gox => {{ .GoxDir }}
{{- if .Postgres }}

replace github.com/guilhermebr/gox/postgres => {{ .GoxDir }}/postgres
{{- end }}
{{- if .Web }}

replace github.com/guilhermebr/gox/web => {{ .GoxDir }}/web
{{- end }}
{{- end }}
