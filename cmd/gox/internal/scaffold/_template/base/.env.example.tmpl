# Every variable this service reads. `go run ./cmd/{{ .Name }} --help` prints the
# same list with types and defaults. Copy to .env for local runs.

{{ .Prefix }}_ENVIRONMENT=development        # development | staging | production
{{ .Prefix }}_HTTP_ADDR=:8080                # PORT is honored when unset
{{ .Prefix }}_ADMIN_ADDR=:9090               # /metrics /healthz /readyz /version /debug/pprof
{{ .Prefix }}_LOG_LEVEL=info                 # debug | info | warn | error
{{ .Prefix }}_LOG_FORMAT=auto                # auto (json in production) | json | text
{{ .Prefix }}_OTEL_ENDPOINT=                 # OTLP collector host:port; export is on in production
{{ .Prefix }}_GREETING=hello
{{- if .Postgres }}

# postgres.Enable()
{{ .Prefix }}_POSTGRES_URL=postgres://user:pass@localhost:5432/{{ .Name }}?sslmode=disable
{{ .Prefix }}_POSTGRES_MIGRATE=true          # false to run migrations as a deploy step
{{- end }}
{{- if .Web }}

# web.Enable()
{{ .Prefix }}_WEB_SESSION_SECRET=            # 32+ random bytes; required in production, ephemeral in development
{{- end }}
